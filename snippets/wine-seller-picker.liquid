{%- doc -%}
  Renders a wine seller variant picker in the Twill style.
  Default: shows the best offer card (variant selected for the existing buy-buttons).
  A "Voir plus de vendeurs" toggle reveals alternative sellers, each with their own
  add-to-cart button that posts directly to the Cart API.

  @param {object} product_resource - The product object (from closest.product)
  @param {object} [block] - The block object

  @example
  {% render 'wine-seller-picker', product_resource: product_resource %}
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% unless product_resource == blank or product_resource.variants.size < 1 %}
  {% liquid
    assign selected_variant = product_resource.selected_or_first_available_variant

    # Separate best-offer variant(s) from the rest
    assign best_variant = nil
    assign other_count = 0
    assign cheapest_other_price = nil

    for variant in product_resource.variants
      assign is_best = variant.metafields.wine.is_best_offer.value
      if is_best == true and best_variant == nil
        assign best_variant = variant
      else
        assign other_count = other_count | plus: 1
        if cheapest_other_price == nil or variant.price < cheapest_other_price
          assign cheapest_other_price = variant.price
        endif
      endif
    endfor

    # Fallback: if no variant is flagged as best, use the first one
    if best_variant == nil
      assign best_variant = product_resource.variants.first
      assign other_count = product_resource.variants.size | minus: 1
      assign cheapest_other_price = nil
      for variant in product_resource.variants
        if variant.id != best_variant.id
          if cheapest_other_price == nil or variant.price < cheapest_other_price
            assign cheapest_other_price = variant.price
          endif
        endif
      endfor
    endif

    # Best offer metafields
    assign best_seller = best_variant.metafields.wine.seller.value
    assign best_is_producer = false
    if best_seller.is_producer == true
      assign best_is_producer = true
    endif
    assign best_seller_name = best_variant.title
    if best_seller.name != blank
      assign best_seller_name = best_seller.name
    endif
    assign best_min_qty = best_variant.metafields.wine.min_quantity.value
    assign best_lot_size = best_variant.metafields.custom.wine_lot_size.value

    assign best_option_value_id = ''
    for ov in best_variant.option_values
      assign best_option_value_id = ov.id
    endfor
  %}

  <wine-selector-component
    class="wine-selector spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-block-id="{{ block.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-url="{{ product_resource.url }}"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {%- comment -%} ===== BEST OFFER CARD ===== {%- endcomment -%}
    <div class="wine-selector__best-offer" data-key="best-offer">
      <span class="wine-selector__section-label">La meilleure offre pour ce produit</span>

      <div class="wine-selector__card wine-selector__card--best-offer">
        <input
          type="radio"
          name="seller-{{ block.id }}-{{ product_resource.id }}"
          value="{{ best_variant.id }}"
          class="visually-hidden"
          data-option-value-id="{{ best_option_value_id }}"
          data-variant-id="{{ best_variant.id }}"
          data-min-quantity="{{ best_min_qty | default: 1 }}"
          data-lot-size="{{ best_lot_size | default: 1 }}"
          ref="bestOfferInput"
          checked
          aria-hidden="true"
        >

        <div class="wine-selector__card-inner">
          <div class="wine-selector__card-header">
            <span class="wine-selector__badge wine-selector__badge--best">Meilleure offre</span>
            {%- if best_is_producer -%}
              <span class="wine-selector__badge wine-selector__badge--producer">Direct Producteur</span>
            {%- endif -%}
          </div>

          <div class="wine-selector__card-body">
            <span class="wine-selector__seller-name">{{ best_seller_name }}</span>
            <span class="wine-selector__price">{{ best_variant.price | money }}</span>
          </div>

          <div class="wine-selector__card-meta">
            {%- if best_variant.available -%}
              <span class="wine-selector__stock wine-selector__stock--available">En stock</span>
            {%- else -%}
              <span class="wine-selector__stock wine-selector__stock--unavailable">Indisponible</span>
            {%- endif -%}
            {%- if best_min_qty != blank and best_min_qty > 1 -%}
              <span class="wine-selector__detail">Min. {{ best_min_qty }} bouteilles</span>
            {%- endif -%}
            {%- if best_lot_size != blank -%}
              <span class="wine-selector__detail">Lot de {{ best_lot_size }}</span>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} ===== OTHER SELLERS TOGGLE ===== {%- endcomment -%}
    {%- if other_count > 0 -%}
      <details class="wine-selector__other-sellers" ref="otherSellers" data-key="other-sellers">
        <summary class="wine-selector__toggle">
          <span>
            {{ other_count }}
            {% if other_count > 1 %}autres offres{% else %}autre offre{% endif %}
            pour ce produit
            {%- if cheapest_other_price != nil %}
              à partir de {{ cheapest_other_price | money }}
            {%- endif -%}
          </span>
          <svg class="wine-selector__chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2 4.5L6 8.5L10 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>

        <div class="wine-selector__other-list">
          {%- for variant in product_resource.variants -%}
            {%- if variant.id == best_variant.id -%}
              {%- continue -%}
            {%- endif -%}

            {%- liquid
              assign seller_mo = variant.metafields.wine.seller.value
              assign s_is_producer = false
              if seller_mo.is_producer == true
                assign s_is_producer = true
              endif
              assign s_name = variant.title
              if seller_mo.name != blank
                assign s_name = seller_mo.name
              endif
              assign s_min_qty = variant.metafields.wine.min_quantity.value
              assign s_lot_size = variant.metafields.custom.wine_lot_size.value
            -%}

            <div class="wine-selector__card" data-key="seller-card-{{ variant.id }}">
              <div class="wine-selector__card-inner">
                <div class="wine-selector__card-header">
                  {%- if s_is_producer -%}
                    <span class="wine-selector__badge wine-selector__badge--producer">Direct Producteur</span>
                  {%- endif -%}
                </div>

                <div class="wine-selector__card-body">
                  <span class="wine-selector__seller-name">{{ s_name }}</span>
                  <span class="wine-selector__price">{{ variant.price | money }}</span>
                </div>

                <div class="wine-selector__card-meta">
                  {%- if variant.available -%}
                    <span class="wine-selector__stock wine-selector__stock--available">En stock</span>
                  {%- else -%}
                    <span class="wine-selector__stock wine-selector__stock--unavailable">Indisponible</span>
                  {%- endif -%}
                  {%- if s_min_qty != blank and s_min_qty > 1 -%}
                    <span class="wine-selector__detail">Min. {{ s_min_qty }} bouteilles</span>
                  {%- endif -%}
                  {%- if s_lot_size != blank -%}
                    <span class="wine-selector__detail">Lot de {{ s_lot_size }}</span>
                  {%- endif -%}
                </div>

                {%- if variant.available -%}
                  <button
                    type="button"
                    class="wine-selector__add-to-cart"
                    data-variant-id="{{ variant.id }}"
                    data-min-quantity="{{ s_min_qty | default: 1 }}"
                    data-lot-size="{{ s_lot_size | default: 1 }}"
                    on:click="/addToCart"
                    ref="addToCartButtons[]"
                  >
                    {%- if s_min_qty != blank and s_min_qty > 1 -%}
                      Ajouter {{ s_min_qty }} bouteilles
                    {%- else -%}
                      Ajouter au panier
                    {%- endif -%}
                  </button>
                {%- else -%}
                  <button type="button" class="wine-selector__add-to-cart" disabled>
                    Indisponible
                  </button>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </details>
    {%- endif -%}

    <script type="application/json">
      {{ best_variant | json }}
    </script>
  </wine-selector-component>
{% endunless %}

{% stylesheet %}
  .wine-selector {
    display: block;
    width: 100%;
  }

  .wine-selector__section-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-block-end: var(--spacing-xs, 6px);
    opacity: 0.6;
  }

  /* ---- Card base ---- */
  .wine-selector__card {
    border: var(--style-border-width-inputs, 1px) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs, 8px);
    transition: border-color 0.15s ease;
  }

  .wine-selector__card--best-offer {
    border-color: var(--color-foreground);
    border-width: 2px;
  }

  .wine-selector__card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs, 6px);
    padding: var(--spacing-md, 14px) var(--spacing-lg, 16px);
  }

  .wine-selector__card-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs, 4px);
  }

  .wine-selector__card-header:empty {
    display: none;
  }

  /* ---- Badges ---- */
  .wine-selector__badge {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .wine-selector__badge--best {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .wine-selector__badge--producer {
    background-color: transparent;
    color: var(--color-foreground);
    border: 1px solid currentcolor;
  }

  /* ---- Card body (name + price) ---- */
  .wine-selector__card-body {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-sm, 8px);
  }

  .wine-selector__seller-name {
    font-weight: 600;
    font-size: 1rem;
  }

  .wine-selector__price {
    font-weight: 600;
    font-size: 1rem;
    white-space: nowrap;
  }

  /* ---- Meta row (stock, details) ---- */
  .wine-selector__card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs, 4px) var(--spacing-sm, 8px);
  }

  .wine-selector__stock {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .wine-selector__stock--available {
    color: #16a34a;
  }

  .wine-selector__stock--unavailable {
    opacity: 0.5;
  }

  .wine-selector__detail {
    font-size: 0.8rem;
    opacity: 0.6;
  }

  /* ---- Other sellers toggle ---- */
  .wine-selector__other-sellers {
    margin-block-start: var(--spacing-sm, 10px);
  }

  .wine-selector__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm, 8px);
    cursor: pointer;
    padding: var(--spacing-sm, 10px) 0;
    font-size: 0.9rem;
    color: var(--color-foreground);
    list-style: none;
  }

  .wine-selector__toggle::-webkit-details-marker {
    display: none;
  }

  .wine-selector__toggle::marker {
    content: '';
  }

  .wine-selector__chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .wine-selector__other-sellers[open] > .wine-selector__toggle .wine-selector__chevron {
    transform: rotate(180deg);
  }

  .wine-selector__other-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm, 8px);
    padding-block-start: var(--spacing-xs, 4px);
  }

  /* ---- Add to cart button (alternative sellers) ---- */
  .wine-selector__add-to-cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-block-start: var(--spacing-xs, 6px);
    padding: var(--spacing-sm, 10px) var(--spacing-md, 14px);
    border: 1px solid var(--color-foreground);
    border-radius: var(--style-border-radius-inputs, 8px);
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .wine-selector__add-to-cart:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .wine-selector__add-to-cart:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .wine-selector__add-to-cart:focus-visible {
    outline: var(--focus-outline-width, 2px) solid currentcolor;
    outline-offset: var(--focus-outline-offset, 2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .wine-selector__chevron {
      transition: none;
    }

    .wine-selector__card {
      transition: none;
    }

    .wine-selector__add-to-cart {
      transition: none;
    }
  }
{% endstylesheet %}
